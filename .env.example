# Copy to .env and fill in. Never commit .env; it is excluded from git and the Docker build context.

# Required for chat/upload agent turns. Injected at runtime only, never at build time.
OPENROUTER_API_KEY=your-openrouter-api-key

# Listen port (default 3000).
PORT=3000
# Bind address (default 127.0.0.1). Compose overrides this to 0.0.0.0 inside the container.
HOST=127.0.0.1
# Must be "true" to bind a non-private address; the app has no login, so restrict access upstream.
ALLOW_PUBLIC_BIND=
# Extra Host header names to accept, comma-separated (e.g. a reverse proxy hostname).
ALLOWED_HOSTS=

# Milliseconds a proposed change waits for staff approval before being cancelled (default 300000).
APPROVAL_TIMEOUT_MS=300000
# Milliseconds between scheduled data snapshots (default 3600000).
BACKUP_INTERVAL_MS=3600000
# Most snapshots kept; the oldest are pruned (default 100).
BACKUP_MAX_SNAPSHOTS=100
# Change-log entries before it rotates (default 5000).
BACKUP_MAX_CHANGES=5000
# Milliseconds to wait for in-flight requests on SIGTERM/SIGINT before forcing exit (default 10000).
SHUTDOWN_TIMEOUT_MS=10000
